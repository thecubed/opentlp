      "label": "Text",
      "type": "text",
      "default": "PNL-2F-1A"
    },
    {
      "name": "cable",
      "label": "Cable diameter (mm)",
      "type": "select",
      "default": "6",
      "options": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "10",
        "12",
        "15"
      ],
      "help": "Sets the length: the label wraps exactly once around a cable this thick."
    },
    {
      "name": "flag",
      "label": "Flag length (mm)",
      "type": "select",
      "default": "25",
