{
  "version": 1,
  "kind": "label-template",
  "id": "example-cable-flag",
  "name": "Cable flag",
  "author": "ULT contributors",
  "description": "Folds around a cable into a flag readable from both sides: the text twice, a blank band in the middle that wraps the cable, and dashed fold lines at its edges. Press the two halves together. The band follows the cable diameter; the flag length is a preset.",
