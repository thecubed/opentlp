{
  "version": 1,
  "kind": "label-template",
  "id": "example-cable-wrap",
  "name": "Cable wrap",
  "author": "ULT contributors",
  "description": "Wraps once around a cable: the text is repeated across the tape four times around the circumference, so one copy always faces you. The first 10 mm are left blank — that end goes under the overlap. Choose the cable diameter and the length follows. On 6 mm tape it makes wire markers. Flexible nylon tape holds best on thin cables.",
  "license": "CC0-1.0",
  "tags": [
    "cables",
    "network",
    "electrical",
    "wire marker"
  ],
  "revision": 1,
  "params": [
    {
      "name": "text",
      "label": "Text",
      "type": "text",
      "default": "PNL-2F-1A"
    },
    {
      "name": "cable",
      "label": "Cable diameter (mm)",
      "type": "select",
      "default": "6",
      "options": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "10",
        "12",
        "15"
      ],
      "help": "Sets the length: the label wraps exactly once around a cable this thick."
    }
  ],
