{
  "name": "universal-label-core",
  "version": "0.1.0",
  "private": false,
  "description": "Printer-agnostic drivers and transports for local label printing.",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./transport/node": {
      "types": "./lib/core/transports/node-ble-transport.d.ts",
      "import": "./lib/core/transports/node-ble-transport.js",
      "require": "./lib/core/transports/node-ble-transport.js"
    },
    "./transport/web": {
      "types": "./lib/core/transports/bluetooth-transport.d.ts",
      "import": "./lib/core/transports/bluetooth-transport.js",
      "require": "./lib/core/transports/bluetooth-transport.js"
    },
    "./transport/capacitor": {
      "types": "./lib/core/transports/capacitor-ble-transport.d.ts",
      "import": "./lib/core/transports/capacitor-ble-transport.js",
      "require": "./lib/core/transports/capacitor-ble-transport.js"
    },
    "./transport/capacitor-usb": {
      "types": "./lib/core/transports/capacitor-usb-transport.d.ts",
      "import": "./lib/core/transports/capacitor-usb-transport.js",
      "require": "./lib/core/transports/capacitor-usb-transport.js"
    },
    "./transport/capacitor-classic": {
      "types": "./lib/core/transports/capacitor-classic-transport.d.ts",
      "import": "./lib/core/transports/capacitor-classic-transport.js",
      "require": "./lib/core/transports/capacitor-classic-transport.js"
    },
    "./transport/dummy": {
      "types": "./lib/core/transports/dummy-transport.d.ts",
      "import": "./lib/core/transports/dummy-transport.js",
      "require": "./lib/core/transports/dummy-transport.js"
    },
    "./transport/usb": {
      "types": "./lib/core/transports/web-usb-transport.d.ts",
      "import": "./lib/core/transports/web-usb-transport.js",
      "require": "./lib/core/transports/web-usb-transport.js"
    },
    "./transport/web-serial": {
      "types": "./lib/core/transports/web-serial-transport.d.ts",
      "import": "./lib/core/transports/web-serial-transport.js",
      "require": "./lib/core/transports/web-serial-transport.js"
    },
    "./transport/rfcomm-bridge": {
      "types": "./lib/core/transports/rfcomm-bridge-transport.d.ts",
      "import": "./lib/core/transports/rfcomm-bridge-transport.js",
      "require": "./lib/core/transports/rfcomm-bridge-transport.js"
    },
    "./transport/node-serial": {
      "types": "./lib/core/transports/node-serial-transport.d.ts",
      "import": "./lib/core/transports/node-serial-transport.js",
      "require": "./lib/core/transports/node-serial-transport.js"
    },
    "./transport/node-usb": {
      "types": "./lib/core/transports/node-usb-transport.d.ts",
      "import": "./lib/core/transports/node-usb-transport.js",
      "require": "./lib/core/transports/node-usb-transport.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:print": "npm run build && npx ts-node --project tsconfig.test.json test-print.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "label",
    "printer",
    "ble",
    "bluetooth",
    "niimbot",
    "catprinter",
    "phomemo",
    "peripage",
    "marklife"
  ],
  "license": "MIT",
  "homepage": "https://github.com/opentlp/opentlp/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentlp/opentlp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/opentlp/opentlp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.2",
    "@capacitor/core": "^8.2.0",
    "@leeskies/capacitor-usb-serial": "^0.2.0",
    "@stoprocent/noble": "^2.8.0",
    "@types/node": "^25.3.5",
    "@types/pako": "^2.0.4",
    "@types/web-bluetooth": "^0.0.21",
    "serialport": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "usb": "^3.0.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@mmote/niimbluelib": "0.0.1-alpha.42",
    "crc-32": "^1.2.2",
    "eventemitter3": "^5.0.1",
    "pako": "^1.0.11"
  },
  "peerDependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.2",
    "@capacitor/core": "^8.2.0",
    "@leeskies/capacitor-usb-serial": "^0.2.0",
    "@stoprocent/noble": "^2.8.0",
    "serialport": "^13.0.0",
    "usb": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "@capacitor-community/bluetooth-le": { "optional": true },
    "@capacitor/core": { "optional": true },
    "@leeskies/capacitor-usb-serial": { "optional": true },
    "@stoprocent/noble": { "optional": true },
    "serialport": { "optional": true },
    "usb": { "optional": true }
  }
}
